# Supabase — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared passcode that gates the whole API (everything except /api/health).
# Pick something long. Without it the API is publicly writable.
APP_PASSCODE=change-me-to-a-long-random-string

# Anthropic API key for AI note parsing (step 3). Without it /api/ai/* returns 503
# and the app falls back to manual filing.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-4-5)
# AI_MODEL=claude-haiku-4-5

# Port the API listens on (Railway/Render inject their own PORT)
PORT=3001

# Comma-separated list of allowed browser origins for CORS.
# Local dev default is http://localhost:5173; add your Vercel URL in production.
FRONTEND_ORIGIN=http://localhost:5173

NODE_ENV=development
